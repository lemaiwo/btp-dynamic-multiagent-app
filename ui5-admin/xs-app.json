{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/backend/(.*)$",
      "target": "/admin/api/$1",
      "destination": "pydantic-agent-backend",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.admin",
      "csrfProtection": false
    },
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "destination": "ui5",
      "authenticationType": "none"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.admin"
    }
  ]
}
