{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "rootDir": "webapp",
    "baseUrl": "./",
    "paths": {
      "com/agent/admin/*": ["webapp/*"]
    },
    "types": ["@sapui5/types"]
  },
  "include": ["webapp/**/*"]
}
