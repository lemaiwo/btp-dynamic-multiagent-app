<mvc:View
    controllerName="com.agent.admin.controller.RunDetail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Page
        id="runDetailPage"
        title="{run>/data/agent_name}"
        showNavButton="true"
        navButtonPress=".onBack">
        <headerContent>
            <Text id="runAutoRefreshStatus" text="{run>/auto/status}" class="sapUiTinyMarginEnd" />
            <ToggleButton
                id="autoRefreshRunToggle"
                icon="sap-icon://synchronize"
                text="{i18n>autoRefresh}"
                pressed="{run>/auto/enabled}"
                press=".onToggleAutoRefresh" />
            <Button
                id="refreshRunDetailButton"
                icon="sap-icon://refresh"
                text="{i18n>refresh}"
                press=".onRefresh" />
            <Button
                id="downloadReportButton"
                icon="sap-icon://download"
                text="{i18n>downloadReport}"
                visible="{run>/hasReport}"
                press=".onDownload" />
        </headerContent>
        <content>
            <VBox class="sapUiSmallMargin">
                <f:SimpleForm layout="ResponsiveGridLayout" editable="false">
                    <Label text="{i18n>colStatus}" />
                    <ObjectStatus
                        id="runStatus"
                        text="{run>/data/status}"
                        state="{ path: 'run>/data/status', formatter: '.formatter.runStatusState' }" />

                    <Label text="{i18n>colTrigger}" />
                    <Text text="{run>/data/trigger}" />

                    <Label text="{i18n>colStarted}" />
                    <Text text="{ path: 'run>/data/started_at', formatter: '.formatter.timestamp' }" />

                    <Label text="{i18n>colDuration}" />
                    <Text text="{ parts: ['run>/data/started_at', 'run>/data/finished_at'], formatter: '.formatter.runDuration' }" />

                    <Label text="{i18n>colSummary}" />
                    <Text text="{run>/data/summary}" />
                </f:SimpleForm>

                <MessageStrip
                    id="runError"
                    text="{run>/data/error}"
                    type="Error"
                    visible="{= !!${run>/data/error} }"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />

                <Title
                    text="{i18n>plan}"
                    level="H3"
                    visible="{= ${run>/plan}.length > 0 }"
                    class="sapUiSmallMarginTop" />
                <List id="runPlanList" items="{run>/plan}" visible="{= ${run>/plan}.length > 0 }">
                    <CustomListItem>
                        <HBox alignItems="Center" class="sapUiTinyMargin">
                            <ObjectStatus
                                text="{run>status}"
                                state="{ path: 'run>status', formatter: '.formatter.todoState' }"
                                class="sapUiSmallMarginEnd" />
                            <Text text="{run>content}" />
                        </HBox>
                    </CustomListItem>
                </List>

                <Title text="{i18n>activity}" level="H3" class="sapUiSmallMarginTop" />
                <List
                    id="runActivityList"
                    items="{run>/events}"
                    noDataText="{i18n>noActivity}"
                    growing="true"
                    growingThreshold="50">
                    <CustomListItem>
                        <VBox class="sapUiTinyMargin">
                            <HBox alignItems="Center">
                                <Text
                                    text="{ path: 'run>ts', formatter: '.formatter.timeOfDay' }"
                                    class="sapUiSmallMarginEnd" />
                                <ObjectStatus
                                    text="{run>status}"
                                    state="{ path: 'run>status', formatter: '.formatter.activityState' }"
                                    visible="{= ${run>kind} === 'tool' }"
                                    class="sapUiSmallMarginEnd" />
                                <Text
                                    text="{= ${run>kind} === 'tool' ? ${run>tool} : ${run>detail} }"
                                    class="sapUiSmallMarginEnd" />
                                <Text text="{run>agent}" />
                            </HBox>
                            <Text
                                text="{run>detail}"
                                visible="{= ${run>kind} === 'tool' &amp;&amp; !!${run>detail} }"
                                class="sapUiTinyMarginTop" />
                            <Text
                                text="{run>output}"
                                visible="{= !!${run>output} }"
                                maxLines="3"
                                class="sapUiTinyMarginTop" />
                        </VBox>
                    </CustomListItem>
                </List>
                <Text
                    id="runActivityDropped"
                    text="{run>/droppedText}"
                    visible="{= !!${run>/droppedText} }" />

                <Title text="{i18n>report}" level="H3" class="sapUiSmallMarginTop" />
                <core:HTML id="reportHtml" content="{run>/reportHtml}" sanitizeContent="false" />
                <Text
                    id="noReportText"
                    text="{i18n>noReport}"
                    visible="{= !${run>/hasReport} }" />
            </VBox>
        </content>
    </Page>
</mvc:View>
