<mvc:View
    controllerName="com.agent.admin.controller.App"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    displayBlock="true"
    height="100%">
    <tnt:ToolPage id="toolPage" sideExpanded="{appView>/sideExpanded}">
        <tnt:header>
            <tnt:ToolHeader id="toolHeader" visible="{appView>/showHeader}">
                <Button
                    icon="sap-icon://menu2"
                    type="Transparent"
                    press=".onToggleSideNav"
                    tooltip="{i18n>toggleNavigation}" />
                <ToolbarSpacer />
                <Title text="{i18n>appTitle}" level="H1" />
                <ToolbarSpacer />
                <!-- The signed-in user sits behind this icon rather than on the
                     header itself: an XSUAA label is an email address, which is
                     both long enough to crowd the title on a narrow window and
                     not something to leave on screen during a shared session. -->
                <MenuButton
                    id="userMenu"
                    icon="sap-icon://person-placeholder"
                    type="Transparent"
                    tooltip="{i18n>userMenuTooltip}">
                    <menu>
                        <Menu id="userMenuList">
                            <MenuItem
                                id="userMenuName"
                                icon="sap-icon://person-placeholder"
                                text="{appView>/userLabel}" />
                        </Menu>
                    </menu>
                </MenuButton>
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation
                id="sideNavigation"
                expanded="{appView>/sideExpanded}"
                selectedKey="{appView>/selectedKey}"
                itemSelect=".onNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="{i18n>navAgents}" icon="sap-icon://person-placeholder" key="agents" />
                    <tnt:NavigationListItem text="{i18n>navSkills}" icon="sap-icon://learning-assistant" key="skills" />
                    <tnt:NavigationListItem text="{i18n>navRuns}" icon="sap-icon://history" key="runs" />
                    <tnt:NavigationListItem text="{i18n>navWorkflows}" icon="sap-icon://process" key="workflows" />
                    <tnt:NavigationListItem text="{i18n>navWorkflowRuns}" icon="sap-icon://workflow-tasks" key="workflowRuns" />
                    <tnt:NavigationListItem text="{i18n>navSettings}" icon="sap-icon://action-settings" key="settings" />
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <NavContainer id="pageContainer" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
