<mvc:View
    controllerName="com.agent.admin.controller.Runs"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">
    <Page id="runsPage" title="{i18n>navRuns}">
        <headerContent>
            <Button id="refreshRunsButton" icon="sap-icon://refresh" text="{i18n>refresh}" press=".onRefresh" />
        </headerContent>
        <content>
            <Table
                id="runsTable"
                items="{runs>/items}"
                growing="true"
                growingThreshold="50"
                noDataText="{i18n>noRuns}">
                <columns>
                    <Column><Text text="{i18n>colAgent}" /></Column>
                    <Column><Text text="{i18n>colStatus}" /></Column>
                    <Column><Text text="{i18n>colTrigger}" /></Column>
                    <Column><Text text="{i18n>colStarted}" /></Column>
                    <Column><Text text="{i18n>colDuration}" /></Column>
                    <Column id="runsTokensColumn" hAlign="End"><Text text="{i18n>colTokens}" /></Column>
                    <Column><Text text="{i18n>colSummary}" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onOpen">
                        <cells>
                            <ObjectIdentifier title="{runs>agent_name}" text="{runs>id}" />
                            <ObjectStatus
                                text="{runs>status}"
                                state="{ path: 'runs>status', formatter: '.formatter.runStatusState' }" />
                            <Text text="{runs>trigger}" />
                            <Text text="{ path: 'runs>started_at', formatter: '.formatter.timestamp' }" />
                            <Text text="{ parts: ['runs>started_at', 'runs>finished_at'], formatter: '.formatter.runDuration' }" />
                            <VBox alignItems="End">
                                <Text text="{ path: 'runs>usage', formatter: '.formatter.tokenTotal' }" />
                                <Text
                                    text="{ parts: ['i18n>runTokensBreakdown', 'runs>usage'], formatter: '.formatter.tokenBreakdown' }"
                                    visible="{ path: 'runs>usage', formatter: '.formatter.hasTokenUsage' }"
                                    class="agentAdminMutedText" />
                                <Text
                                    text="{ parts: ['i18n>runCost', 'i18n>runCostSmall', 'i18n>runCostPartly', 'runs>cost'], formatter: '.formatter.costText' }"
                                    tooltip="{i18n>runCostHint}"
                                    visible="{ path: 'runs>cost', formatter: '.formatter.hasCost' }"
                                    class="agentAdminMutedText" />
                            </VBox>
                            <Text text="{ parts: ['runs>summary', 'runs>error'], formatter: '.formatter.runSummary' }" maxLines="2" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
