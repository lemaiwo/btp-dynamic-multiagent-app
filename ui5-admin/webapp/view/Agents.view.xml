<mvc:View
    controllerName="com.agent.admin.controller.Agents"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core">
    <Page id="agentsPage" title="{i18n>navAgents}">
        <headerContent>
            <Button id="addAgentButton" icon="sap-icon://add" text="{i18n>newAgent}" press=".onCreate" />
        </headerContent>
        <content>
            <!--
              Credential alert. A scheduled run acts as an agent's run-as
              principal and refreshes nothing until it needs to, so a lapsed
              token is invisible until a nightly job quietly produces nothing.
              This is the one place an operator reliably looks, so it says so
              here rather than only in a log nobody reads.
            -->
            <MessageStrip
                id="credentialAlert"
                visible="{= ${credhealth>/problems}.length &gt; 0 }"
                type="Warning"
                showIcon="true"
                class="sapUiSmallMarginBottom"
                text="{credhealth>/summary}">
                <link>
                    <Link id="credentialAlertLink" text="{i18n>credAlertFix}" press=".onOpenCredentialProblem" />
                </link>
            </MessageStrip>
            <Table
                id="agentsTable"
                items="{agents>/items}"
                growing="true"
                growingThreshold="50"
                noDataText="{i18n>noAgents}">
                <headerToolbar>
                    <OverflowToolbar>
                        <SearchField
                            id="agentSearch"
                            width="18rem"
                            placeholder="{i18n>searchAgents}"
                            liveChange=".onSearch" />
                        <ToolbarSpacer />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="{i18n>colName}" /></Column>
                    <Column><Text text="{i18n>colDescription}" /></Column>
                    <Column><Text text="{i18n>colToolsets}" /></Column>
                    <Column><Text text="{i18n>colStatus}" /></Column>
                    <Column hAlign="End"><Text text="{i18n>colActions}" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onOpen">
                        <cells>
                            <ObjectIdentifier title="{agents>name}" text="{agents>api_slug}" />
                            <Text text="{agents>description}" maxLines="2" />
                            <Text text="{ path: 'agents>mcp_servers', formatter: '.formatter.serverSummary' }" />
                            <ObjectStatus
                                text="{= ${agents>enabled} ? ${i18n>enabled} : ${i18n>disabled} }"
                                state="{= ${agents>enabled} ? 'Success' : 'None' }" />
                            <HBox>
                                <Button
                                    icon="sap-icon://play"
                                    type="Transparent"
                                    tooltip="{i18n>runNow}"
                                    visible="{agents>expose_api}"
                                    press=".onRunNow" />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="{i18n>delete}"
                                    press=".onDelete" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
