<mvc:View
    controllerName="com.agent.admin.controller.Settings"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form">
    <Page id="settingsPage" title="{i18n>navSettings}">
        <VBox class="sapUiSmallMargin">

            <Panel headerText="{i18n>llmModel}" expandable="false">
                <f:SimpleForm layout="ResponsiveGridLayout" editable="true">
                    <Label text="{i18n>activeModel}" />
                    <Select
                        id="modelSelect"
                        selectedKey="{settings>/model/model_name}"
                        items="{settings>/model/available}">
                        <core:Item key="{settings>}" text="{settings>}" xmlns:core="sap.ui.core" />
                    </Select>
                    <Label text="" />
                    <Button
                        id="saveModelButton"
                        text="{i18n>saveModel}"
                        type="Emphasized"
                        press=".onSaveModel" />
                </f:SimpleForm>
            </Panel>

            <!-- The direct model providers Anthropic and OpenAI:
                 controller/settings/ModelProviders.ts keeps the `mp` model;
                 one fragment per provider, bound to its block. -->
            <Panel
                id="modelProvidersPanel"
                headerText="{i18n>mpPanelTitle}"
                expandable="false"
                busy="{mp>/loading}"
                busyIndicatorDelay="200"
                class="sapUiSmallMarginTop">
                <MessageStrip
                    id="mpLoadError"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${mp>/loadError} }"
                    text="{mp>/loadError}"
                    class="sapUiTinyMarginTopBottom">
                    <link>
                        <Link id="mpRetry" text="{i18n>mpRetry}" press=".onRetryModelProviders" />
                    </link>
                </MessageStrip>
                <MessageStrip
                    id="mpInfoStrip"
                    type="Information"
                    showIcon="true"
                    visible="{mp>/loaded}"
                    text="{mp>/info}"
                    class="sapUiTinyMarginTopBottom" />
                <VBox id="mpAnthropicBlock" binding="{mp>/providers/anthropic}" visible="{mp>/loaded}">
                    <core:Fragment
                        xmlns:core="sap.ui.core"
                        id="mpAnthropic"
                        fragmentName="com.agent.admin.fragment.ModelProviderBlock"
                        type="XML" />
                </VBox>
                <VBox id="mpOpenaiBlock" binding="{mp>/providers/openai}" visible="{mp>/loaded}" class="sapUiSmallMarginTop">
                    <core:Fragment
                        xmlns:core="sap.ui.core"
                        id="mpOpenai"
                        fragmentName="com.agent.admin.fragment.ModelProviderBlock"
                        type="XML" />
                </VBox>
            </Panel>

            <!-- Data catalogue embeddings (design addendum (l), point 4):
                 controller/settings/Embeddings.ts keeps the `emb` model. -->
            <Panel
                id="embeddingsPanel"
                headerText="{i18n>embPanelTitle}"
                expandable="false"
                busy="{emb>/loading}"
                busyIndicatorDelay="200"
                class="sapUiSmallMarginTop">
                <Text text="{i18n>embPanelHint}" class="sapUiTinyMarginBottom" />
                <MessageStrip
                    id="embLoadError"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${emb>/loadError} }"
                    text="{emb>/loadError}"
                    class="sapUiTinyMarginTopBottom">
                    <link>
                        <Link id="embRetry" text="{i18n>embRetry}" press=".onRetryEmbeddings" />
                    </link>
                </MessageStrip>
                <MessageStrip
                    id="embAicoreStrip"
                    type="Warning"
                    showIcon="true"
                    visible="{= !!${emb>/aicoreStrip} }"
                    text="{emb>/aicoreStrip}"
                    class="sapUiTinyMarginTopBottom" />
                <MessageStrip
                    id="embEnvStrip"
                    type="Information"
                    showIcon="true"
                    visible="{= !!${emb>/envStrip} }"
                    text="{emb>/envStrip}"
                    class="sapUiTinyMarginTopBottom" />
                <f:SimpleForm layout="ResponsiveGridLayout" editable="true" visible="{emb>/loaded}">
                    <Label text="{i18n>embLineModel}" />
                    <ObjectStatus id="embModelLine" text="{emb>/lines/embLineModel/text}" state="{emb>/lines/embLineModel/state}" />
                    <Label text="{i18n>embLineVectors}" />
                    <ObjectStatus id="embVectorsLine" text="{emb>/lines/embLineVectors/text}" state="{emb>/lines/embLineVectors/state}" />
                    <Label text="{i18n>embLineStale}" />
                    <ObjectStatus id="embStaleLine" text="{emb>/lines/embLineStale/text}" state="{emb>/lines/embLineStale/state}" />
                    <Label text="{i18n>embLineLastRun}" />
                    <ObjectStatus id="embLastRunLine" text="{emb>/lines/embLineLastRun/text}" state="{emb>/lines/embLineLastRun/state}" />
                    <Label text="{i18n>embUseLabel}" labelFor="embEnabledSwitch" />
                    <Switch id="embEnabledSwitch" state="{emb>/form/enabled}" />
                    <Label text="{i18n>embModelLabel}" labelFor="embModelSelect" />
                    <Select
                        id="embModelSelect"
                        selectedKey="{emb>/form/modelKey}"
                        items="{ path: 'emb>/options', templateShareable: false }"
                        valueState="{emb>/modelState}"
                        valueStateText="{emb>/modelStateText}"
                        change=".onEmbeddingsModelChange">
                        <core:Item key="{emb>key}" text="{emb>text}" xmlns:core="sap.ui.core" />
                    </Select>
                    <Label text="" />
                    <HBox wrap="Wrap">
                        <Button
                            id="embSaveButton"
                            text="{i18n>embSave}"
                            type="Emphasized"
                            enabled="{= !${emb>/busy} }"
                            press=".onSaveEmbeddings" />
                        <Button
                            id="embRunButton"
                            text="{i18n>embRun}"
                            enabled="{= ${emb>/canRun} &amp;&amp; !${emb>/busy} }"
                            press=".onRunEmbeddings"
                            class="sapUiTinyMarginBegin" />
                        <Button
                            id="embDeployButton"
                            text="{i18n>embDeployOpen}"
                            enabled="{= ${emb>/canDeploy} &amp;&amp; !${emb>/busy} }"
                            press=".onOpenEmbeddingsDeploy"
                            class="sapUiTinyMarginBegin" />
                    </HBox>
                </f:SimpleForm>
            </Panel>

            <!-- Model prices (cost in euros): controller/settings/ModelPrices.ts
                 keeps the `prices` model. Rates stay text end to end. -->
            <Panel
                id="modelPricesPanel"
                headerText="{i18n>mpcPanelTitle}"
                expandable="false"
                busy="{prices>/loading}"
                busyIndicatorDelay="200"
                class="sapUiSmallMarginTop">
                <Text id="mpcHint" text="{i18n>mpcHint}" class="sapUiTinyMarginBottom" />
                <MessageStrip
                    id="mpcLoadError"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${prices>/loadError} }"
                    text="{prices>/loadError}"
                    class="sapUiTinyMarginTopBottom">
                    <link>
                        <Link id="mpcRetry" text="{i18n>mpcRetry}" press=".onRetryModelPrices" />
                    </link>
                </MessageStrip>
                <VBox id="mpcContent" visible="{prices>/loaded}">
                    <f:SimpleForm layout="ResponsiveGridLayout" editable="true">
                        <Label id="mpcCuPriceLabel" text="{i18n>mpcCuPriceLabel}" labelFor="mpcCuPrice" />
                        <Input
                            id="mpcCuPrice"
                            value="{prices>/form/cuPrice}"
                            placeholder="{i18n>mpcCuPricePlaceholder}"
                            valueState="{prices>/cuState}"
                            valueStateText="{prices>/cuStateText}"
                            width="12rem" />
                    </f:SimpleForm>
                    <Table
                        id="mpcTable"
                        items="{ path: 'prices>/form/rows', templateShareable: false }"
                        noDataText="{i18n>mpcNoRows}"
                        ariaLabelledBy="mpcTableTitle">
                        <headerToolbar>
                            <Toolbar>
                                <Title id="mpcTableTitle" text="{i18n>mpcTableTitle}" level="H3" />
                                <ToolbarSpacer />
                                <Button
                                    id="mpcAddButton"
                                    text="{i18n>mpcAdd}"
                                    icon="sap-icon://add"
                                    enabled="{= !${prices>/busy} }"
                                    press=".onAddModelPrice" />
                            </Toolbar>
                        </headerToolbar>
                        <columns>
                            <Column><Text id="mpcColModel" text="{i18n>mpcColModel}" /></Column>
                            <Column><Text id="mpcColInput" text="{i18n>mpcColInput}" /></Column>
                            <Column><Text id="mpcColCached" text="{i18n>mpcColCached}" /></Column>
                            <Column><Text id="mpcColOutput" text="{i18n>mpcColOutput}" /></Column>
                            <Column><Text id="mpcColStatus" text="{i18n>mpcColStatus}" /></Column>
                            <Column width="4rem" hAlign="End"><Text id="mpcColRemove" text="" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <Input
                                    value="{prices>model}"
                                    editable="{= !${prices>unpriced} }"
                                    ariaLabelledBy="mpcColModel"
                                    valueState="{prices>modelState}"
                                    valueStateText="{prices>modelStateText}" />
                                <Input
                                    value="{prices>input}"
                                    ariaLabelledBy="mpcColInput"
                                    valueState="{prices>inputState}"
                                    valueStateText="{prices>inputStateText}" />
                                <Input
                                    value="{prices>cached}"
                                    placeholder="{i18n>mpcCachedPlaceholder}"
                                    ariaLabelledBy="mpcColCached"
                                    valueState="{prices>cachedState}"
                                    valueStateText="{prices>cachedStateText}" />
                                <Input
                                    value="{prices>output}"
                                    ariaLabelledBy="mpcColOutput"
                                    valueState="{prices>outputState}"
                                    valueStateText="{prices>outputStateText}" />
                                <ObjectStatus
                                    text="{i18n>mpcNoPrice}"
                                    state="Warning"
                                    visible="{prices>unpriced}" />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="{i18n>mpcRemove}"
                                    enabled="{= !${prices>/busy} }"
                                    press=".onRemoveModelPrice" />
                            </ColumnListItem>
                        </items>
                    </Table>
                    <HBox class="sapUiSmallMarginTop" alignItems="Center">
                        <Button
                            id="mpcSaveButton"
                            text="{i18n>mpcSave}"
                            type="Emphasized"
                            enabled="{= !${prices>/busy} }"
                            press=".onSaveModelPrices" />
                        <ObjectStatus
                            id="mpcUnsaved"
                            text="{i18n>mpcUnsaved}"
                            state="Information"
                            visible="{prices>/dirty}"
                            class="sapUiSmallMarginBegin" />
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="{i18n>orchestratorInstructions}" expandable="false" class="sapUiSmallMarginTop">
                <f:SimpleForm layout="ResponsiveGridLayout" editable="true">
                    <Label text="{i18n>orchestratorInstructions}" labelFor="orchestratorInstructions" />
                    <TextArea
                        id="orchestratorInstructions"
                        value="{settings>/orchestrator/instructions}"
                        rows="14"
                        growing="false"
                        width="100%" />
                    <Label text="" />
                    <Button
                        id="saveOrchestratorButton"
                        text="{i18n>saveInstructions}"
                        type="Emphasized"
                        press=".onSaveOrchestrator" />
                </f:SimpleForm>
            </Panel>

            <Panel headerText="{i18n>lifecycle}" expandable="false" class="sapUiSmallMarginTop">
                <Text text="{i18n>lifecycleHint}" />
                <HBox class="sapUiSmallMarginTop">
                    <Button id="reloadButton" text="{i18n>reload}" press=".onReload" />
                    <Button id="restartButton" text="{i18n>restart}" type="Attention" press=".onRestart" class="sapUiTinyMarginBegin" />
                </HBox>
            </Panel>

            <Panel headerText="{i18n>importExport}" expandable="false" class="sapUiSmallMarginTop">
                <HBox>
                    <Button id="exportButton" text="{i18n>exportConfig}" press=".onExport" />
                    <Button id="importButton" text="{i18n>importConfig}" press=".onOpenImport" class="sapUiTinyMarginBegin" />
                </HBox>
            </Panel>

        </VBox>
    </Page>
</mvc:View>
