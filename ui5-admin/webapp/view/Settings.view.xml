<mvc:View
    controllerName="com.agent.admin.controller.Settings"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form">
    <Page id="settingsPage" title="{i18n>navSettings}">
        <VBox class="sapUiSmallMargin">

            <Panel headerText="{i18n>llmModel}" expandable="false">
                <f:SimpleForm layout="ResponsiveGridLayout" editable="true">
                    <Label text="{i18n>activeModel}" />
                    <Select
                        id="modelSelect"
                        selectedKey="{settings>/model/model_name}"
                        items="{settings>/model/available}">
                        <core:Item key="{settings>}" text="{settings>}" xmlns:core="sap.ui.core" />
                    </Select>
                    <Label text="" />
                    <Button
                        id="saveModelButton"
                        text="{i18n>saveModel}"
                        type="Emphasized"
                        press=".onSaveModel" />
                </f:SimpleForm>
            </Panel>

            <!-- Data catalogue embeddings (design addendum (l), point 4):
                 controller/settings/Embeddings.ts keeps the `emb` model. -->
            <Panel
                id="embeddingsPanel"
                headerText="{i18n>embPanelTitle}"
                expandable="false"
                busy="{emb>/loading}"
                busyIndicatorDelay="200"
                class="sapUiSmallMarginTop">
                <Text text="{i18n>embPanelHint}" class="sapUiTinyMarginBottom" />
                <MessageStrip
                    id="embLoadError"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${emb>/loadError} }"
                    text="{emb>/loadError}"
                    class="sapUiTinyMarginTopBottom" />
                <MessageStrip
                    id="embEnvStrip"
                    type="Information"
                    showIcon="true"
                    visible="{= !!${emb>/envStrip} }"
                    text="{emb>/envStrip}"
                    class="sapUiTinyMarginTopBottom" />
                <f:SimpleForm layout="ResponsiveGridLayout" editable="true" visible="{emb>/loaded}">
                    <Label text="{i18n>embLineModel}" />
                    <ObjectStatus id="embModelLine" text="{emb>/lines/embLineModel/text}" state="{emb>/lines/embLineModel/state}" />
                    <Label text="{i18n>embLineVectors}" />
                    <ObjectStatus id="embVectorsLine" text="{emb>/lines/embLineVectors/text}" state="{emb>/lines/embLineVectors/state}" />
                    <Label text="{i18n>embLineStale}" />
                    <ObjectStatus id="embStaleLine" text="{emb>/lines/embLineStale/text}" state="{emb>/lines/embLineStale/state}" />
                    <Label text="{i18n>embLineLastRun}" />
                    <ObjectStatus id="embLastRunLine" text="{emb>/lines/embLineLastRun/text}" state="{emb>/lines/embLineLastRun/state}" />
                    <Label text="{i18n>embUseLabel}" labelFor="embEnabledSwitch" />
                    <Switch id="embEnabledSwitch" state="{emb>/form/enabled}" />
                    <Label text="{i18n>embModelLabel}" labelFor="embModelSelect" />
                    <Select
                        id="embModelSelect"
                        selectedKey="{emb>/form/modelKey}"
                        items="{ path: 'emb>/options', templateShareable: false }"
                        valueState="{emb>/modelState}"
                        valueStateText="{emb>/modelStateText}"
                        change=".onEmbeddingsModelChange">
                        <core:Item key="{emb>key}" text="{emb>text}" xmlns:core="sap.ui.core" />
                    </Select>
                    <Label text="" />
                    <HBox wrap="Wrap">
                        <Button
                            id="embSaveButton"
                            text="{i18n>embSave}"
                            type="Emphasized"
                            enabled="{= !${emb>/busy} }"
                            press=".onSaveEmbeddings" />
                        <Button
                            id="embRunButton"
                            text="{i18n>embRun}"
                            enabled="{= ${emb>/canRun} &amp;&amp; !${emb>/busy} }"
                            press=".onRunEmbeddings"
                            class="sapUiTinyMarginBegin" />
                        <Button
                            id="embDeployButton"
                            text="{i18n>embDeployOpen}"
                            enabled="{= !${emb>/busy} }"
                            press=".onOpenEmbeddingsDeploy"
                            class="sapUiTinyMarginBegin" />
                    </HBox>
                </f:SimpleForm>
            </Panel>

            <Panel headerText="{i18n>orchestratorInstructions}" expandable="false" class="sapUiSmallMarginTop">
                <f:SimpleForm layout="ResponsiveGridLayout" editable="true">
                    <Label text="{i18n>orchestratorInstructions}" labelFor="orchestratorInstructions" />
                    <TextArea
                        id="orchestratorInstructions"
                        value="{settings>/orchestrator/instructions}"
                        rows="14"
                        growing="false"
                        width="100%" />
                    <Label text="" />
                    <Button
                        id="saveOrchestratorButton"
                        text="{i18n>saveInstructions}"
                        type="Emphasized"
                        press=".onSaveOrchestrator" />
                </f:SimpleForm>
            </Panel>

            <Panel headerText="{i18n>lifecycle}" expandable="false" class="sapUiSmallMarginTop">
                <Text text="{i18n>lifecycleHint}" />
                <HBox class="sapUiSmallMarginTop">
                    <Button id="reloadButton" text="{i18n>reload}" press=".onReload" />
                    <Button id="restartButton" text="{i18n>restart}" type="Attention" press=".onRestart" class="sapUiTinyMarginBegin" />
                </HBox>
            </Panel>

            <Panel headerText="{i18n>importExport}" expandable="false" class="sapUiSmallMarginTop">
                <HBox>
                    <Button id="exportButton" text="{i18n>exportConfig}" press=".onExport" />
                    <Button id="importButton" text="{i18n>importConfig}" press=".onOpenImport" class="sapUiTinyMarginBegin" />
                </HBox>
            </Panel>

        </VBox>
    </Page>
</mvc:View>
