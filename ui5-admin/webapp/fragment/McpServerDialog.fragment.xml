<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="serverDialog" title="{i18n>mcpServer}" contentWidth="42rem">
        <!-- odata: what the entry has to say about its selection, above the
             form (a MessageStrip is no form content). Bound as text. -->
        <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
              visible="{= ${server>/url} === 'builtin:odata' }">
        <MessageStrip
            id="odataEntryDuplicate"
            type="Error"
            showIcon="true"
            text="{server>/odata/duplicate}"
            class="sapUiTinyMarginBottom"
            visible="{= ${server>/url} === 'builtin:odata' &amp;&amp; !!${server>/odata/duplicate} }" />
        <MessageStrip
            id="odataEntryLoadError"
            type="Error"
            showIcon="true"
            text="{server>/odata/loadError}"
            class="sapUiTinyMarginBottom"
            visible="{= ${server>/url} === 'builtin:odata' &amp;&amp; !!${server>/odata/loadError} }" />
        <MessageStrip
            id="odataEntryMissing"
            type="Warning"
            showIcon="true"
            text="{server>/odata/missing}"
            class="sapUiTinyMarginBottom"
            visible="{= ${server>/url} === 'builtin:odata' &amp;&amp; !!${server>/odata/missing} }" />
        <MessageStrip
            id="odataEntryDisabled"
            type="Information"
            showIcon="true"
            text="{server>/odata/disabled}"
            class="sapUiTinyMarginBottom"
            visible="{= ${server>/url} === 'builtin:odata' &amp;&amp; !!${server>/odata/disabled} }" />
        <MessageStrip
            id="odataEntryWarning"
            type="Warning"
            showIcon="true"
            text="{server>/odata/warning}"
            class="sapUiTinyMarginBottom"
            visible="{= ${server>/url} === 'builtin:odata' &amp;&amp; !!${server>/odata/warning} }" />
        </VBox>
        <f:SimpleForm layout="ResponsiveGridLayout" editable="true">

            <Label text="{i18n>toolsetKind}" />
            <Select
                id="serverKind"
                selectedKey="{server>/kind}"
                change=".onServerKindChange"
                items="{server>/kinds}">
                <core:Item key="{server>key}" text="{server>text}" />
            </Select>

            <Label text="" visible="{= ${server>/kind} !== 'mcp' }" />
            <Text id="serverKindDescription" text="{server>/kindDescription}"
                  visible="{= ${server>/kind} !== 'mcp' }" />

            <Label text="{i18n>serverUrl}" required="true" visible="{= ${server>/kind} === 'mcp' }" />
            <Input
                id="serverUrl"
                value="{server>/url}"
                valueState="{server>/errors/urlState}"
                valueStateText="{server>/errors/url}"
                placeholder="{i18n>serverUrlPlaceholder}"
                change=".onServerUrlChange"
                visible="{= ${server>/kind} === 'mcp' }" />

            <!-- builtin:odata has one mode and nothing to choose: hidden there. -->
            <Label text="{i18n>authMode}" visible="{= ${server>/url} !== 'builtin:odata' }" />
            <Select
                id="serverAuthMode"
                selectedKey="{server>/auth_mode}"
                change=".onAuthModeChange"
                visible="{= ${server>/url} !== 'builtin:odata' }"
                items="{server>/authModes}">
                <core:Item key="{server>key}" text="{server>text}" />
            </Select>

            <Label text="" visible="{= ${server>/auth_mode} === 'session' }" />
            <Text text="{i18n>sessionHint}"
                  visible="{= ${server>/auth_mode} === 'session' }" />

            <Label text="{i18n>oauthDcr}" visible="{= ${server>/auth_mode} === 'oauth2' }" />
            <CheckBox
                id="oauthDcr"
                selected="{server>/oauth/dcr}"
                text="{i18n>oauthDcrHint}"
                visible="{= ${server>/auth_mode} === 'oauth2' }" />

            <Label text="{i18n>clientId}" visible="{= ((${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr}) || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />
            <Input
                id="oauthClientId"
                value="{server>/oauth/client_id}"
                visible="{= ((${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr}) || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />

            <Label text="{i18n>clientSecret}" visible="{= ((${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr}) || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />
            <Input
                id="oauthClientSecret"
                type="Password"
                value="{server>/oauth/client_secret}"
                placeholder="{server>/secretPlaceholder}"
                visible="{= ((${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr}) || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />

            <Label text="{i18n>uaaUrl}" visible="{= ((${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr}) || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />
            <Input
                id="oauthUaaUrl"
                value="{server>/oauth/uaa_url}"
                placeholder="{i18n>uaaUrlHint}"
                visible="{= ((${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr}) || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />

            <Label text="{i18n>authorizeUrl}" visible="{= ${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr} &amp;&amp; ${server>/auth_mode} !== 'destination' }" />
            <Input
                id="oauthAuthorizeUrl"
                value="{server>/oauth/authorize_url}"
                visible="{= ${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr} &amp;&amp; ${server>/auth_mode} !== 'destination' }" />

            <Label text="{i18n>tokenUrl}" visible="{= ((${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr}) || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />
            <Input
                id="oauthTokenUrl"
                value="{server>/oauth/token_url}"
                visible="{= ((${server>/auth_mode} === 'oauth2' &amp;&amp; !${server>/oauth/dcr}) || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />

            <Label text="{i18n>oauthScope}" visible="{= (${server>/auth_mode} === 'oauth2' || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />
            <Input
                id="oauthScope"
                value="{server>/oauth/scope}"
                placeholder="{server>/scopeHint}"
                visible="{= (${server>/auth_mode} === 'oauth2' || ${server>/auth_mode} === 'app_only') &amp;&amp; ${server>/auth_mode} !== 'destination' }" />

            <Label text="{i18n>mailbox}" required="true" visible="{= (${server>/auth_mode} === 'app_only' &amp;&amp; ${server>/url} !== 'builtin:teams' &amp;&amp; ${server>/url} !== 'builtin:sharepoint') || (${server>/auth_mode} === 'destination' &amp;&amp; (${server>/url} === 'builtin:outlook' || ${server>/url} === 'builtin:gmail') &amp;&amp; !${server>/oauth/user_context}) }" />
            <Input
                id="oauthMailbox"
                value="{server>/oauth/mailbox}"
                placeholder="{i18n>mailboxHint}"
                visible="{= (${server>/auth_mode} === 'app_only' &amp;&amp; ${server>/url} !== 'builtin:teams' &amp;&amp; ${server>/url} !== 'builtin:sharepoint') || (${server>/auth_mode} === 'destination' &amp;&amp; (${server>/url} === 'builtin:outlook' || ${server>/url} === 'builtin:gmail') &amp;&amp; !${server>/oauth/user_context}) }" />

            <Label text="{i18n>teamLabel}" required="true"
                   visible="{= ${server>/url} === 'builtin:teams' }" />
            <Input
                id="oauthTeam"
                value="{server>/oauth/team}"
                placeholder="{i18n>teamHint}"
                visible="{= ${server>/url} === 'builtin:teams' }" />

            <!-- sharepoint: the one pinned workbook. The three pins are sent as
                 typed (not trimmed); the views are edited as JSON text and
                 checked by the server's gate. Kept by cleanSharePoint. -->
            <Label text="{i18n>sharePointSiteLabel}" required="true" labelFor="oauthSharePointSite"
                   visible="{= ${server>/url} === 'builtin:sharepoint' }" />
            <Input
                id="oauthSharePointSite"
                value="{server>/oauth/site}"
                placeholder="{i18n>sharePointSiteHint}"
                visible="{= ${server>/url} === 'builtin:sharepoint' }" />

            <Label text="{i18n>sharePointLibraryLabel}" required="true" labelFor="oauthSharePointLibrary"
                   visible="{= ${server>/url} === 'builtin:sharepoint' }" />
            <Input
                id="oauthSharePointLibrary"
                value="{server>/oauth/library}"
                placeholder="{i18n>sharePointLibraryHint}"
                visible="{= ${server>/url} === 'builtin:sharepoint' }" />

            <Label text="{i18n>sharePointPathLabel}" required="true" labelFor="oauthSharePointPath"
                   visible="{= ${server>/url} === 'builtin:sharepoint' }" />
            <Input
                id="oauthSharePointPath"
                value="{server>/oauth/path}"
                placeholder="{i18n>sharePointPathHint}"
                visible="{= ${server>/url} === 'builtin:sharepoint' }" />

            <Label text="{i18n>sharePointViewsLabel}" required="true" labelFor="oauthSharePointViews"
                   visible="{= ${server>/url} === 'builtin:sharepoint' }" />
            <TextArea
                id="oauthSharePointViews"
                value="{server>/viewsJson}"
                rows="10"
                width="100%"
                placeholder="{i18n>sharePointViewsPlaceholder}"
                valueState="{server>/errors/viewsState}"
                valueStateText="{server>/errors/views}"
                visible="{= ${server>/url} === 'builtin:sharepoint' }" />

            <!-- bitbucket: the agent's one pull request review entry. Its state
                 lives under server>/bitbucket, apart from server>/oauth (only the
                 destination name is shared), so that nothing of it reaches another
                 toolset's block and no other toolset's tick arrives here. Workspace
                 and branch are sent as typed (not trimmed). Approving needs
                 commenting; the build requirement only matters while approving. -->
            <Label text="{i18n>bitbucketWorkspaceLabel}" required="true" labelFor="oauthBitbucketWorkspace"
                   visible="{= ${server>/url} === 'builtin:bitbucket' }" />
            <Input
                id="oauthBitbucketWorkspace"
                value="{server>/bitbucket/workspace}"
                placeholder="{i18n>bitbucketWorkspaceHint}"
                visible="{= ${server>/url} === 'builtin:bitbucket' }" />

            <Label text="{i18n>bitbucketRepositoriesLabel}" labelFor="oauthBitbucketRepositories"
                   visible="{= ${server>/url} === 'builtin:bitbucket' }" />
            <VBox visible="{= ${server>/url} === 'builtin:bitbucket' }">
                <Input
                    id="oauthBitbucketRepositories"
                    value="{server>/bitbucket/repositoriesText}"
                    placeholder="{i18n>bitbucketRepositoriesPlaceholder}"
                    ariaDescribedBy="oauthBitbucketRepositoriesHint" />
                <Text id="oauthBitbucketRepositoriesHint" text="{i18n>bitbucketRepositoriesHint}"
                      class="sapUiTinyMarginTop" />
            </VBox>

            <Label text="{i18n>bitbucketBranchLabel}" labelFor="oauthBitbucketBranch"
                   visible="{= ${server>/url} === 'builtin:bitbucket' }" />
            <Input
                id="oauthBitbucketBranch"
                value="{server>/bitbucket/branch}"
                placeholder="{i18n>bitbucketBranchHint}"
                visible="{= ${server>/url} === 'builtin:bitbucket' }" />

            <Label text="{i18n>bitbucketAllowCommentLabel}" labelFor="oauthBitbucketAllowComment"
                   visible="{= ${server>/url} === 'builtin:bitbucket' }" />
            <CheckBox
                id="oauthBitbucketAllowComment"
                selected="{server>/bitbucket/allowComment}"
                select=".onBitbucketSwitch"
                text="{i18n>bitbucketAllowCommentHint}"
                wrapping="true"
                visible="{= ${server>/url} === 'builtin:bitbucket' }" />

            <Label text="{i18n>bitbucketAllowApproveLabel}" labelFor="oauthBitbucketAllowApprove"
                   visible="{= ${server>/url} === 'builtin:bitbucket' }" />
            <CheckBox
                id="oauthBitbucketAllowApprove"
                selected="{server>/bitbucket/allowApprove}"
                enabled="{= ${server>/bitbucket/allowComment} === true }"
                select=".onBitbucketSwitch"
                text="{i18n>bitbucketAllowApproveHint}"
                wrapping="true"
                visible="{= ${server>/url} === 'builtin:bitbucket' }" />

            <Label text="{i18n>bitbucketGreenBuildsLabel}" labelFor="oauthBitbucketGreenBuilds"
                   visible="{= ${server>/url} === 'builtin:bitbucket' }" />
            <CheckBox
                id="oauthBitbucketGreenBuilds"
                selected="{server>/bitbucket/requireGreenBuilds}"
                enabled="{= ${server>/bitbucket/allowApprove} === true }"
                text="{i18n>bitbucketGreenBuildsHint}"
                wrapping="true"
                visible="{= ${server>/url} === 'builtin:bitbucket' }" />

            <Label text="{i18n>channelsLabel}"
                   visible="{= ${server>/url} === 'builtin:teams' || ${server>/url} === 'builtin:slack' }" />
            <Input
                id="oauthChannels"
                value="{server>/oauth/channels}"
                placeholder="{= ${server>/url} === 'builtin:slack' ? ${i18n>slackChannelsHint} : ${i18n>channelsHint} }"
                visible="{= ${server>/url} === 'builtin:teams' || ${server>/url} === 'builtin:slack' }" />

            <!-- Whatever is visible for a url and mode below must also be kept
                 by model/oauthConfig.ts cleanOAuth, or OK silently drops it. -->
            <Label text="{i18n>recipientsLabel}"
                   visible="{= (${server>/url} === 'builtin:outlook' &amp;&amp; (${server>/auth_mode} === 'oauth2' || ${server>/auth_mode} === 'app_only' || ${server>/auth_mode} === 'destination')) || (${server>/url} === 'builtin:smtp' &amp;&amp; ${server>/auth_mode} === 'destination') }" />
            <Input
                id="oauthRecipients"
                value="{server>/oauth/recipients}"
                placeholder="{i18n>recipientsPlaceholder}"
                visible="{= (${server>/url} === 'builtin:outlook' &amp;&amp; (${server>/auth_mode} === 'oauth2' || ${server>/auth_mode} === 'app_only' || ${server>/auth_mode} === 'destination')) || (${server>/url} === 'builtin:smtp' &amp;&amp; ${server>/auth_mode} === 'destination') }" />

            <Label text="{i18n>smtpFromLabel}"
                   visible="{= ${server>/url} === 'builtin:smtp' &amp;&amp; ${server>/auth_mode} === 'destination' }" />
            <Input
                id="oauthSmtpFrom"
                value="{server>/oauth/from}"
                placeholder="{i18n>smtpFromPlaceholder}"
                visible="{= ${server>/url} === 'builtin:smtp' &amp;&amp; ${server>/auth_mode} === 'destination' }" />

            <!-- Kept by cleanOAuth for smtp/outlook only; see MailTheme in
                 agents/mail_render.py for the keys. -->
            <Label text="{i18n>mailThemeLabel}"
                   visible="{= (${server>/url} === 'builtin:outlook' &amp;&amp; (${server>/auth_mode} === 'oauth2' || ${server>/auth_mode} === 'app_only' || ${server>/auth_mode} === 'destination')) || (${server>/url} === 'builtin:smtp' &amp;&amp; ${server>/auth_mode} === 'destination') }" />
            <TextArea
                id="oauthMailTheme"
                value="{server>/themeJson}"
                rows="5"
                width="100%"
                placeholder="{i18n>mailThemePlaceholder}"
                valueState="{server>/errors/themeState}"
                valueStateText="{server>/errors/theme}"
                visible="{= (${server>/url} === 'builtin:outlook' &amp;&amp; (${server>/auth_mode} === 'oauth2' || ${server>/auth_mode} === 'app_only' || ${server>/auth_mode} === 'destination')) || (${server>/url} === 'builtin:smtp' &amp;&amp; ${server>/auth_mode} === 'destination') }" />

            <Label text="{i18n>lookback}" visible="{= (${server>/auth_mode} === 'app_only' &amp;&amp; ${server>/url} !== 'builtin:sharepoint') || (${server>/auth_mode} === 'destination' &amp;&amp; ${server>/kind} !== 'mcp' &amp;&amp; ${server>/url} !== 'builtin:gmail' &amp;&amp; ${server>/url} !== 'builtin:sapnotedetail' &amp;&amp; ${server>/url} !== 'builtin:smtp' &amp;&amp; ${server>/url} !== 'builtin:odata' &amp;&amp; ${server>/url} !== 'builtin:sharepoint' &amp;&amp; ${server>/url} !== 'builtin:bitbucket') || ${server>/url} === 'builtin:teams' || ${server>/url} === 'builtin:outlook' }" />
            <Input
                id="oauthLookback"
                value="{server>/oauth/lookback}"
                placeholder="{i18n>lookbackHint}"
                visible="{= (${server>/auth_mode} === 'app_only' &amp;&amp; ${server>/url} !== 'builtin:sharepoint') || (${server>/auth_mode} === 'destination' &amp;&amp; ${server>/kind} !== 'mcp' &amp;&amp; ${server>/url} !== 'builtin:gmail' &amp;&amp; ${server>/url} !== 'builtin:sapnotedetail' &amp;&amp; ${server>/url} !== 'builtin:smtp' &amp;&amp; ${server>/url} !== 'builtin:odata' &amp;&amp; ${server>/url} !== 'builtin:sharepoint' &amp;&amp; ${server>/url} !== 'builtin:bitbucket') || ${server>/url} === 'builtin:teams' || ${server>/url} === 'builtin:outlook' }" />

            <Label text="{i18n>allowSend}" visible="{= (${server>/auth_mode} === 'app_only' &amp;&amp; ${server>/url} !== 'builtin:teams' &amp;&amp; ${server>/url} !== 'builtin:sharepoint') || (${server>/auth_mode} === 'oauth2' &amp;&amp; (${server>/url} === 'builtin:teams' || ${server>/url} === 'builtin:outlook' || ${server>/url} === 'builtin:gmail')) || ${server>/url} === 'builtin:slack' || (${server>/auth_mode} === 'destination' &amp;&amp; (${server>/url} === 'builtin:outlook' || ${server>/url} === 'builtin:smtp' || (${server>/url} === 'builtin:teams' &amp;&amp; ${server>/oauth/user_context} === true))) }" />
            <CheckBox
                id="oauthAllowSend"
                selected="{server>/oauth/allow_send}"
                text="{= ${server>/url} === 'builtin:teams' ? ${i18n>allowPostHint} : ${server>/url} === 'builtin:slack' ? ${i18n>allowSlackPostHint} : ${server>/url} === 'builtin:smtp' ? ${i18n>allowSmtpSendHint} : ${i18n>allowSendHint} }"
                visible="{= (${server>/auth_mode} === 'app_only' &amp;&amp; ${server>/url} !== 'builtin:teams' &amp;&amp; ${server>/url} !== 'builtin:sharepoint') || (${server>/auth_mode} === 'oauth2' &amp;&amp; (${server>/url} === 'builtin:teams' || ${server>/url} === 'builtin:outlook' || ${server>/url} === 'builtin:gmail')) || ${server>/url} === 'builtin:slack' || (${server>/auth_mode} === 'destination' &amp;&amp; (${server>/url} === 'builtin:outlook' || ${server>/url} === 'builtin:smtp' || (${server>/url} === 'builtin:teams' &amp;&amp; ${server>/oauth/user_context} === true))) }" />

            <Label text="{i18n>minScoreLabel}"
                   visible="{= ${server>/url} === 'builtin:sapnotes' }" />
            <Input
                id="oauthMinScore"
                value="{server>/oauth/min_score}"
                placeholder="{i18n>minScorePlaceholder}"
                visible="{= ${server>/url} === 'builtin:sapnotes' }" />

            <!-- builtin:odata names no destination: each catalogue service has its own. -->
            <Label text="{i18n>destinationName}" required="true"
                   visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} !== 'builtin:odata' }" />
            <Input
                id="oauthDestination"
                value="{server>/oauth/destination}"
                placeholder="{= ${server>/url} === 'builtin:slack' ? 'MY_SLACK_DESTINATION' : ${server>/url} === 'builtin:jira' ? 'MY_JIRA_DESTINATION' : ${server>/url} === 'builtin:gmail' ? 'MY_GMAIL_DESTINATION' : ${server>/url} === 'builtin:sapnotes' ? 'MY_NVD_DESTINATION' : ${server>/url} === 'builtin:sapnotedetail' ? 'MY_SAP_ME_DESTINATION' : ${server>/url} === 'builtin:smtp' ? 'MY_MAIL_DESTINATION' : ${server>/url} === 'builtin:bitbucket' ? 'MY_BITBUCKET_DESTINATION' : ${server>/kind} === 'mcp' ? 'MY_MCP_DESTINATION' : 'MY_GRAPH_DESTINATION' }"
                visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} !== 'builtin:odata' }" />

            <!-- destinations: whose credential the destination hands back.
                 Whatever is visible here must be kept by cleanOAuth too:
                 formatter.userContextVisible uses the same isRemote helper. -->
            <Label text="{i18n>userContext}"
                   visible="{ parts: ['server>/auth_mode', 'server>/url'], formatter: '.formatter.userContextVisible' }" />
            <CheckBox
                id="oauthUserContext"
                selected="{server>/oauth/user_context}"
                select=".onUserContextToggle"
                text="{i18n>userContextHint}"
                wrapping="true"
                visible="{ parts: ['server>/auth_mode', 'server>/url'], formatter: '.formatter.userContextVisible' }" />

            <Label text=""
                   visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; (${server>/url} === 'builtin:gmail' || ${server>/url} === 'builtin:outlook' || ${server>/url} === 'builtin:teams') }" />
            <Text id="destinationGraphHint" text="{i18n>destinationGraphHint}"
                  visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; (${server>/url} === 'builtin:gmail' || ${server>/url} === 'builtin:outlook' || ${server>/url} === 'builtin:teams') }" />

            <Label text=""
                   visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/kind} === 'mcp' }" />
            <Text id="destinationMcpHint" text="{i18n>destinationMcpHint}"
                  visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/kind} === 'mcp' }" />

            <Label text=""
                   visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:sapnotedetail' }" />
            <Text id="destinationCookieHint" text="{i18n>destinationCookieHint}"
                  visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:sapnotedetail' }" />

            <Label text=""
                   visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:sapnotes' }" />
            <Text id="destinationNvdHint" text="{i18n>destinationNvdHint}"
                  visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:sapnotes' }" />

            <Label text="{i18n>jiraProject}" visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />
            <Input
                id="oauthProject"
                value="{server>/oauth/project}"
                placeholder="ABC"
                visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />

            <Label text="{i18n>jiraStatus}" visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />
            <Input
                id="oauthStatus"
                value="{server>/oauth/status}"
                placeholder="{i18n>jiraStatusHint}"
                visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />

            <Label text="{i18n>jiraLabels}" visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />
            <Input
                id="oauthLabels"
                value="{server>/oauth/labels}"
                placeholder="{i18n>jiraLabelsHint}"
                visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />

            <Label text="{i18n>jiraApiBase}" visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />
            <Input
                id="oauthApiBase"
                value="{server>/oauth/api_base}"
                placeholder="{i18n>jiraApiBaseHint}"
                visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />

            <Label text="{i18n>allowComment}" visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />
            <CheckBox
                id="oauthAllowComment"
                selected="{server>/oauth/allow_comment}"
                text="{i18n>allowCommentHint}"
                visible="{= ${server>/auth_mode} === 'destination' &amp;&amp; ${server>/url} === 'builtin:jira' }" />

            <!-- odata: the agent's one OData services entry. Its state lives
                 under server>/odata, apart from server>/oauth, so that a click on
                 another toolset and back cannot lose the selection and nothing of
                 it leaks into another toolset's block. Every text below is bound
                 as text: titles and purposes are admin text from the catalogue. -->
            <!-- One way: the model is the selection, written only by
                 onODataEntryChange. Two way, the box wrote the keys of the dialog
                 shown before into a new entry once its items arrived. -->
            <Label text="{i18n>odataEntryServices}" required="true" labelFor="odataEntryServices"
                   visible="{= ${server>/url} === 'builtin:odata' }" />
            <MultiComboBox
                id="odataEntryServices"
                width="100%"
                showSecondaryValues="true"
                placeholder="{i18n>odataEntryServicesPlaceholder}"
                items="{server>/odata/options}"
                selectedKeys="{ path: 'server>/odata/services', mode: 'OneWay' }"
                selectionChange=".onODataEntryChange"
                selectionFinish=".onODataEntryChange"
                visible="{= ${server>/url} === 'builtin:odata' }">
                <core:ListItem key="{server>key}" text="{server>text}" additionalText="{server>identity}" />
            </MultiComboBox>

            <Label text="" visible="{= ${server>/url} === 'builtin:odata' }" />
            <List
                id="odataEntrySelected"
                width="100%"
                items="{server>/odata/rows}"
                noDataText="{server>/odata/noData}"
                showSeparators="Inner"
                ariaLabelledBy="odataEntrySelectedLabel"
                visible="{= ${server>/url} === 'builtin:odata' }">
                <StandardListItem
                    title="{server>title}"
                    description="{server>purpose}"
                    info="{server>info}"
                    infoState="{server>infoState}"
                    wrapping="true" />
            </List>
            <core:InvisibleText id="odataEntrySelectedLabel" text="{i18n>odataEntrySelectedLabel}" />

            <Label text="{i18n>odataEntryAllowWrite}" labelFor="odataEntryAllowWrite"
                   visible="{= ${server>/url} === 'builtin:odata' }" />
            <CheckBox
                id="odataEntryAllowWrite"
                selected="{server>/odata/allowWrite}"
                select=".onODataEntryChange"
                text="{i18n>odataEntryAllowWriteHint}"
                wrapping="true"
                ariaDescribedBy="odataEntryAllowWriteText"
                visible="{= ${server>/url} === 'builtin:odata' }" />

            <Label text="" visible="{= ${server>/url} === 'builtin:odata' }" />
            <Text id="odataEntryAllowWriteText" text="{server>/odata/writeText}"
                  visible="{= ${server>/url} === 'builtin:odata' }" />

        </f:SimpleForm>
        <beginButton>
            <Button id="serverConfirm" text="{i18n>ok}" type="Emphasized" press=".onConfirmServer" />
        </beginButton>
        <endButton>
            <Button id="serverCancel" text="{i18n>cancel}" press=".onCancelServer" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
