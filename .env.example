# SAP AI Core credentials (option A: individual variables)
AICORE_AUTH_URL=https://<instance>.authentication.<region>.hana.ondemand.com/oauth/token
AICORE_CLIENT_ID=your-client-id
AICORE_CLIENT_SECRET=your-client-secret
AICORE_BASE_URL=https://api.ai.<region>.cfapps.sap.hana.ondemand.com/v2
# AI Core meters consumption per resource group. "default" is the tenant-wide
# group. Point this at a dedicated group to get a separate line in the bill --
# but note deployments are per group, so a fresh group has no models until
# scripts/deploy_claude.py has run against it. See docs/AICORE_RESOURCE_GROUP.md
# (local, not in repo: docs/ is landscape-specific and gitignored).
AICORE_RESOURCE_GROUP=default

# scripts/ensure_aicore_setup.py (also run as an MTA deploy hook) creates the
# group above if it is missing. Defaults shown; both are optional.
# AICORE_ENSURE_STRICT=true    # false => warn instead of failing the deploy
# AICORE_ENSURE_TIMEOUT=300    # seconds to wait for PROVISIONED

# Or (option B: full service key JSON as a single line)
# AICORE_SERVICE_KEY={"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}

# Dynamic agent registry storage.
# On SAP BTP this is resolved from the bound postgresql-db service.
# Locally, point at a running PostgreSQL instance, or leave unset to
# fall back to a local SQLite file (agents_registry.db).
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agents

# Optional: restrict the MCP URLs admins can register.
# Comma-separated list of URL prefixes. Default allows any *.hana.ondemand.com.
# MCP_URL_ALLOWLIST=https://my-mcp-a.cfapps.eu20-001.hana.ondemand.com,https://my-mcp-b.cfapps.eu20-001.hana.ondemand.com

# Optional: public base URL used to build the OAuth2 redirect_uri
# (<base>/oauth/callback) for per-user MCP servers (auth_mode=oauth2).
# Defaults to A2A_PUBLIC_URL, then to the request's forwarded host.
# Locally this resolves to http://127.0.0.1:7932 automatically.
# PUBLIC_BASE_URL=https://<approuter-host>

# Optional: CF API restart (Restart app button). Bind a user-provided service
# named 'cf-api' instead if possible. SpaceDeveloper role required.
# CF_USERNAME=
# CF_PASSWORD=

# Outlook / Microsoft Graph probe (scripts/probe_outlook.py).
# Only needed to run the go/no-go probe. The agent itself takes the client id
# and secret from the admin UI and stores them in the app's database in
# plaintext (protected by access to that database, not by encryption), along
# with each user's tokens. Use a dedicated app registration with the least
# permissions the agent needs, so a database leak exposes no more than that.
# See docs/OUTLOOK_SETUP.md steps 1-2 (local, not in repo).
# OUTLOOK_TENANT_ID=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_FOLDER=agent
# OUTLOOK_MAILBOX=service.mailbox@example.com   # app-only probe target

# Dialog S-user / SAP Universal ID used ONLY to obtain a me.sap.com browser
# session for builtin:sapnotedetail. This is a form login, so it has to be a
# dialog user, not a technical communication user. Read by
# scripts/sap_session.py on an operator machine; never deployed, and nothing
# under agents/ reads it (the app reads the stored session cookie instead).
SAP_DIALOG_USER=
SAP_DIALOG_PWD=

# Technical communication user for the SAP Support Backbone. Read only by the
# exploratory probes scripts/probe_sapnotes_*.py and probe_me_sap_notes_api.py;
# neither builtin:sapnotes (public NVD API, optional NVD_API_KEY) nor
# builtin:sapnotedetail (session cookie above) uses it at runtime.
# SAP_NOTES_USER=
# SAP_NOTES_PWD=
# NVD_API_KEY=
