{
  "_version": "1.59.0",
  "sap.app": {
    "id": "com.agent.ide",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [""],
      "fallbackLocale": ""
    },
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.ui.layout": {}
      }
    },
    "rootView": {
      "viewName": "com.agent.ide.view.App",
      "type": "XML",
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "com.agent.ide.view",
        "controlId": "pageContainer",
        "controlAggregation": "pages"
      },
      "routes": [
        { "pattern": ["sessions", ""], "name": "sessions", "target": "sessions" },
        { "pattern": "sessions/{id}:?query:", "name": "session", "target": "session" }
      ],
      "targets": {
        "sessions": { "id": "sessions", "name": "Worklist" },
        "session": { "id": "session", "name": "Session" }
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.agent.ide.i18n.i18n",
          "supportedLocales": [""],
          "fallbackLocale": ""
        }
      }
    },
    "resources": { "css": [{ "uri": "css/style.css" }] }
  }
}
