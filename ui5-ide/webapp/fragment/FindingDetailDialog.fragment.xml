<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:codeeditor="sap.ui.codeeditor">
    <!-- The dump or trace text of one finding. It is shown as plain text in a read-only
         editor: nothing of it is rendered as markup. Only the editor is busy while the text
         loads, so Close stays usable. -->
    <Dialog
        id="findingDetailDialog"
        title="{ide>/findingDetail/title}"
        contentWidth="60rem"
        contentHeight="32rem"
        resizable="true"
        draggable="true"
        verticalScrolling="false"
        horizontalScrolling="false"
        initialFocus="findingDetailCloseButton"
        afterClose=".onFindingDetailAfterClose">
        <codeeditor:CodeEditor
            id="findingDetailEditor"
            type="text"
            value="{ide>/findingDetail/text}"
            editable="false"
            lineNumbers="true"
            syntaxHints="false"
            busy="{ide>/findingDetail/busy}"
            busyIndicatorDelay="0"
            height="100%"
            width="100%" />
        <buttons>
            <Button
                id="findingDetailRefreshButton"
                text="{i18n>refreshButton}"
                icon="sap-icon://refresh"
                tooltip="{i18n>findingDetailRefreshTooltip}"
                enabled="{= !${ide>/findingDetail/busy} &amp;&amp; ${ide>/findingDetail/canRefresh} }"
                press=".onFindingDetailRefresh" />
            <Button id="findingDetailCloseButton" text="{i18n>close}" press=".onFindingDetailClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
