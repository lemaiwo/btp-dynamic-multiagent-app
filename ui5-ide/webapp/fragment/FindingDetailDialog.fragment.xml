<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- The dump or trace text of one finding. It is shown as plain text in a read-only
         text area: nothing of it is rendered as markup. Only the text area is busy while the
         text loads, so Close stays usable. -->
    <Dialog
        id="findingDetailDialog"
        title="{s>/findingDetail/title}"
        contentWidth="60rem"
        contentHeight="32rem"
        resizable="true"
        draggable="true"
        verticalScrolling="false"
        horizontalScrolling="false"
        initialFocus="findingDetailCloseButton"
        afterClose=".onFindingDetailAfterClose">
        <TextArea
            id="findingDetailEditor"
            class="ideFindingDetailText"
            value="{s>/findingDetail/text}"
            editable="false"
            wrapping="Off"
            busy="{s>/findingDetail/busy}"
            busyIndicatorDelay="0"
            height="100%"
            width="100%" />
        <buttons>
            <Button
                id="findingDetailRefreshButton"
                text="{i18n>refreshButton}"
                icon="sap-icon://refresh"
                tooltip="{i18n>findingDetailRefreshTooltip}"
                enabled="{= !${s>/findingDetail/busy} &amp;&amp; ${s>/findingDetail/canRefresh} }"
                press=".onFindingDetailRefresh" />
            <Button id="findingDetailCloseButton" text="{i18n>close}" press=".onFindingDetailClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
