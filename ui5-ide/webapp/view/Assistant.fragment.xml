<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <OverflowToolbar id="assistantToolbar" style="Clear">
        <Title id="assistantTitle" text="{i18n>assistantTitle}" level="H2" />
        <ToolbarSpacer />
        <ObjectStatus
            id="usageStatus"
            text="{ide>/run/usageText}"
            visible="{= !!${ide>/run/usageText} }"
            state="None" />
    </OverflowToolbar>
    <!-- Names the stage bar: the controller sets role="group" and aria-labelledby on its DOM (an HBox has no ariaLabelledBy) -->
    <core:InvisibleText id="stageBarLabel" text="{i18n>stageBarLabel}" />
    <core:InvisibleText id="chatListLabel" text="{i18n>chatListLabel}" />
    <core:InvisibleText id="chatInputLabel" text="{i18n>chatInputLabel}" />

    <!-- Diagnose sessions say up front what the AI model sees and what is kept: unmasked and stored
         for 14 days by default. A session that says `masked: true` is on a target that lost its
         non-production flag: the server refuses its runs and live reads (409
         target_not_non_production), so the strip is a warning that says so and what stays. With
         an icon, so its meaning does not rest on colour. -->
    <MessageStrip
        id="diagnoseBanner"
        class="sapUiTinyMarginBeginEnd sapUiTinyMarginBottom"
        type="{= ${ide>/session/masked} === true ? 'Warning' : 'Information' }"
        showIcon="true"
        visible="{= ${ide>/session/type} === 'diagnose' }"
        text="{= ${ide>/session/masked} === true ? ${i18n>diagnoseBannerMasked} : ${i18n>diagnoseBanner} }" />

    <!-- Stage bar: six tokens, done / current / upcoming; a diagnose session has the single step Investigate -->
    <HBox
        id="stageBar"
        class="ideStageBar sapUiTinyMarginBeginEnd"
        wrap="Wrap"
        alignItems="Center"
        items="{ide>/assistant/stages}">
        <ObjectStatus
            class="ideStageToken sapUiTinyMarginEnd sapUiTinyMarginBottom"
            text="{ide>label}"
            tooltip="{ide>tooltip}"
            icon="{= ${ide>state} === 'done' ? 'sap-icon://accept' : ${ide>state} === 'current' ? 'sap-icon://navigation-right-arrow' : '' }"
            inverted="{= ${ide>state} === 'current' }"
            state="{= ${ide>state} === 'done' ? 'Success' : ${ide>state} === 'current' ? 'Information' : 'None' }" />
    </HBox>
    <OverflowToolbar id="stageActions" style="Clear">
        <Button
            id="approveButton"
            text="{i18n>approveButton}"
            type="Accept"
            icon="sap-icon://accept"
            enabled="{ide>/assistant/canApprove}"
            tooltip="{ide>/assistant/approveTooltip}"
            visible="{= ${ide>/session/type} !== 'diagnose' }"
            press=".onApprove" />
        <Button
            id="reviseButton"
            text="{i18n>reviseButton}"
            icon="sap-icon://edit"
            enabled="{ide>/assistant/canRevise}"
            tooltip="{ide>/assistant/reviseTooltip}"
            visible="{= ${ide>/session/type} !== 'diagnose' }"
            press=".onRevise" />
        <!-- Diagnose sessions: no stages to approve; write the report, then hand it over to a change session. -->
        <Button
            id="reportButton"
            text="{i18n>reportButton}"
            type="Emphasized"
            icon="sap-icon://document-text"
            enabled="{ide>/assistant/canReport}"
            tooltip="{ide>/assistant/reportTooltip}"
            visible="{= ${ide>/session/type} === 'diagnose' }"
            press=".onReport" />
        <Button
            id="handoverButton"
            text="{i18n>handoverButton}"
            icon="sap-icon://forward"
            enabled="{ide>/assistant/canHandover}"
            tooltip="{ide>/assistant/handoverTooltip}"
            visible="{= ${ide>/session/type} === 'diagnose' }"
            press=".onHandover" />
        <ToolbarSpacer />
        <Button
            id="stopButton"
            text="{i18n>stopButton}"
            type="Reject"
            icon="sap-icon://stop"
            tooltip="{i18n>stopTooltip}"
            visible="{ide>/assistant/running}"
            press=".onStop" />
    </OverflowToolbar>

    <!-- Conversation: user text plain, assistant markdown sanitized (model/markdown). Start, end and
         errors of a run are announced (InvisibleMessage, polite); the input stays focusable while a run
         goes on (read-only, not disabled), so the focus is not lost. -->
    <ScrollContainer id="chatScroll" vertical="true" horizontal="false" width="100%" height="100%" class="ideChatScroll">
        <layoutData>
            <FlexItemData growFactor="1" baseSize="0" minHeight="0" />
        </layoutData>
        <List
            id="chatList"
            showSeparators="Inner"
            noDataText="{= ${ide>/session/type} === 'diagnose' ? ${i18n>chatEmptyDiagnose} : ${i18n>chatEmpty} }"
            ariaLabelledBy="chatListLabel"
            items="{ path: 'ide>/messages', key: 'id' }">
            <CustomListItem class="ideChatItem">
                <VBox class="ideChatMessage">
                    <HBox alignItems="Center">
                        <Label
                            text="{= ${ide>isUser} ? ${i18n>roleUser} : ${ide>role} === 'system' ? ${i18n>roleSystem} : ${i18n>roleAssistant} }"
                            design="Bold"
                            class="sapUiTinyMarginEnd" />
                        <ObjectStatus
                            text="{i18n>messageCancelled}"
                            state="Warning"
                            visible="{ide>cancelled}" />
                    </HBox>
                    <Text text="{ide>content}" visible="{ide>isUser}" renderWhitespace="true" />
                    <core:HTML content="{ide>html}" visible="{= !${ide>isUser} }" preferDOM="false" />
                </VBox>
            </CustomListItem>
        </List>

        <!-- Diagnose sessions: trace requests waiting for the user's decision, and the decided ones -->
        <core:Fragment fragmentName="com.agent.ide.fragment.ApprovalCard" type="XML" />

        <!-- The answer being streamed: re-rendered at most once per animation frame -->
        <VBox id="streamBubble" class="ideChatMessage ideStreamBubble" visible="{ide>/assistant/running}">
            <HBox alignItems="Center">
                <Label text="{i18n>roleAssistant}" design="Bold" class="sapUiTinyMarginEnd" />
                <BusyIndicator size="1rem" />
                <Text
                    id="streamStatus"
                    text="{ide>/run/status}"
                    class="sapUiTinyMarginBegin" />
            </HBox>
            <core:HTML id="streamHtml" content="{ide>/run/html}" preferDOM="false" />
        </VBox>

        <!-- A remark of the run that is not a failure (no diagnose server, conventions not loaded) -->
        <MessageStrip
            id="runWarning"
            class="sapUiSmallMargin"
            type="Warning"
            showIcon="true"
            showCloseButton="true"
            text="{ide>/run/warning}"
            visible="{= !!${ide>/run/warning} }"
            close=".onRunWarningClose" />
        <MessageStrip
            id="runError"
            class="sapUiSmallMargin"
            type="Error"
            showIcon="true"
            showCloseButton="true"
            text="{ide>/run/error}"
            visible="{= !!${ide>/run/error} }"
            close=".onRunErrorClose" />
    </ScrollContainer>

    <!-- Activity: the plan (todos) and the tool calls of the last run; collapsed until asked for -->
    <Panel
        id="activityPanel"
        headerText="{ide>/activity/title}"
        expandable="true"
        expanded="false"
        class="ideActivityPanel">
        <ScrollContainer vertical="true" horizontal="false" width="100%" height="16rem">
            <Title text="{i18n>activityTodos}" level="H4" class="sapUiTinyMarginBegin" />
            <List
                id="activityTodos"
                showSeparators="None"
                noDataText="{i18n>activityNoTodos}"
                items="{ide>/activity/todos}">
                <CustomListItem>
                    <ObjectStatus
                        class="sapUiTinyMarginBeginEnd sapUiTinyMarginTopBottom"
                        text="{ide>mark} {ide>content}"
                        icon="{ide>icon}"
                        state="{ide>state}" />
                </CustomListItem>
            </List>
            <Title text="{i18n>activityTools}" level="H4" class="sapUiTinyMarginBegin sapUiSmallMarginTop" />
            <List
                id="activityTimeline"
                showSeparators="Inner"
                noDataText="{i18n>activityNoTools}"
                items="{ path: 'ide>/activity/events' }">
                <CustomListItem>
                    <VBox class="sapUiTinyMargin">
                        <HBox alignItems="Center" wrap="Wrap">
                            <ObjectStatus
                                class="sapUiTinyMarginEnd"
                                text="{ide>title}"
                                icon="{ide>icon}"
                                state="{ide>state}"
                                tooltip="{ide>status}" />
                            <ObjectStatus
                                class="sapUiTinyMarginEnd"
                                text="{ide>refusedText}"
                                state="Warning"
                                visible="{ide>refused}" />
                            <Text text="{ide>agent}" class="ideActivityAgent" />
                        </HBox>
                        <Text text="{ide>detail}" maxLines="2" visible="{= !!${ide>detail} }" />
                        <Text
                            text="{ide>output}"
                            maxLines="{= ${ide>expanded} ? 0 : 3 }"
                            class="ideActivityOutput"
                            visible="{ide>hasOutput}" />
                        <Link
                            text="{= ${ide>expanded} ? ${i18n>activityShowLess} : ${i18n>activityShowMore} }"
                            visible="{ide>hasOutput}"
                            press=".onActivityToggle" />
                    </VBox>
                </CustomListItem>
            </List>
        </ScrollContainer>
    </Panel>

    <VBox id="chatComposer" class="ideChatComposer">
        <TextArea
            id="chatInput"
            value="{ide>/draft}"
            valueLiveUpdate="true"
            placeholder="{i18n>chatPlaceholder}"
            ariaLabelledBy="chatInputLabel"
            rows="3"
            growing="true"
            growingMaxLines="10"
            maxLength="20000"
            width="100%"
            enabled="{= !!${ide>/session} }"
            editable="{ide>/assistant/canSend}" />
        <HBox justifyContent="End">
            <Button
                id="sendButton"
                text="{i18n>sendButton}"
                type="Emphasized"
                icon="sap-icon://paper-plane"
                enabled="{ parts: ['ide>/assistant/canSend', 'ide>/draft'], formatter: '.formatCanSubmit' }"
                press=".onSend" />
        </HBox>
    </VBox>
</core:FragmentDefinition>
