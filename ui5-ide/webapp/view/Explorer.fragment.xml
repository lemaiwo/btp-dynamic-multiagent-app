<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Title id="explorerTitle" text="{i18n>explorerTitle}" level="H2" class="sapUiSmallMarginBegin sapUiSmallMarginTop" />
    <core:InvisibleText id="newSessionLabel" text="{i18n>newSessionTooltip}" />
    <core:InvisibleText id="deleteSessionLabel" text="{i18n>deleteSessionTooltip}" />
    <core:InvisibleText id="openObjectLabel" text="{i18n>openObjectLabel}" />

    <List
        id="sessionList"
        mode="SingleSelectMaster"
        growing="true"
        growingThreshold="50"
        busy="{ide>/sessionsBusy}"
        busyIndicatorDelay="0"
        noDataText="{i18n>noSessions}"
        ariaLabelledBy="sessionsTitle"
        selectionChange=".onSessionSelect"
        items="{ide>/sessions}">
        <headerToolbar>
            <OverflowToolbar id="sessionsToolbar">
                <Title id="sessionsTitle" text="{i18n>sessionsTitle}" level="H3" />
                <ToolbarSpacer />
                <Button
                    id="newSessionButton"
                    icon="sap-icon://add"
                    type="Transparent"
                    tooltip="{i18n>newSessionTooltip}"
                    ariaLabelledBy="newSessionLabel"
                    press=".onNewSession" />
                <Button
                    id="deleteSessionButton"
                    icon="sap-icon://delete"
                    type="Transparent"
                    tooltip="{i18n>deleteSessionTooltip}"
                    ariaLabelledBy="deleteSessionLabel"
                    enabled="{= !!${ide>/selectedId} }"
                    press=".onDeleteSession" />
            </OverflowToolbar>
        </headerToolbar>
        <ObjectListItem
            title="{ide>title}"
            icon="{= ${ide>type} === 'diagnose' ? 'sap-icon://stethoscope' : '' }"
            selected="{= ${ide>id} === ${ide>/selectedId} }"
            type="Active">
            <firstStatus>
                <ObjectStatus
                    text="{ path: 'ide>stage', formatter: '.formatter.stageText' }"
                    state="{ path: 'ide>stage', formatter: '.formatter.stageState' }" />
            </firstStatus>
            <ObjectAttribute text="{ path: 'ide>target', formatter: '.formatTarget' }" />
        </ObjectListItem>
    </List>

    <!-- Diagnose sessions: what the assistant found, newest first, in place of the workspace tree.
         A row leads to its source; the details button shows the finding's dump or trace text. -->
    <List
        id="findingsList"
        class="sapUiSmallMarginTop"
        visible="{= ${ide>/session/type} === 'diagnose' }"
        busy="{ide>/findingsBusy}"
        busyIndicatorDelay="0"
        noDataText="{i18n>findingsEmpty}"
        ariaLabelledBy="findingsTitle"
        items="{ path: 'ide>/findings', key: 'id' }">
        <headerToolbar>
            <OverflowToolbar id="findingsToolbar">
                <Title
                    id="findingsTitle"
                    level="H3"
                    text="{ parts: ['i18n>findingsTitle', 'ide>/findings/length'], formatter: '.formatter.countTitle' }" />
            </OverflowToolbar>
        </headerToolbar>
        <CustomListItem type="Navigation" press=".onFindingPress">
            <HBox alignItems="Center" class="ideFinding">
                <core:Icon
                    src="{ path: 'ide>kind', formatter: '.formatter.findingIcon' }"
                    decorative="true"
                    class="sapUiSmallMarginEnd" />
                <VBox>
                    <layoutData>
                        <FlexItemData growFactor="1" baseSize="0" minWidth="0" />
                    </layoutData>
                    <Text text="{ide>title}" class="ideFindingTitle" />
                    <Text
                        text="{ parts: ['ide>program', 'ide>include', 'ide>line', 'ide>occurred_at'], formatter: '.formatter.formatFindingWhere' }"
                        class="ideFindingWhere" />
                    <Text text="{ path: 'ide>kind', formatter: '.formatter.findingKindText' }" class="ideFindingKind" />
                </VBox>
                <Button
                    icon="sap-icon://detail-view"
                    type="Transparent"
                    tooltip="{i18n>findingDetailsTooltip}"
                    visible="{ path: 'ide>kind', formatter: '.formatter.findingHasDetail' }"
                    press=".onFindingDetails" />
            </HBox>
        </CustomListItem>
    </List>

    <OverflowToolbar id="workspaceToolbar" class="sapUiSmallMarginTop">
        <!-- A diagnose session has no workspace tree: the heading names what is left under it, the object search. -->
        <Title
            id="workspaceTitle"
            text="{= ${ide>/session/type} === 'diagnose' ? ${i18n>openObjectLabel} : ${i18n>workspaceTitle} }"
            level="H3" />
    </OverflowToolbar>
    <SearchField
        id="openObjectSearch"
        class="sapUiTinyMarginBeginEnd"
        width="auto"
        placeholder="{i18n>openObjectPlaceholder}"
        tooltip="{i18n>openObjectTooltip}"
        ariaLabelledBy="openObjectLabel"
        enabled="{= !!${ide>/selectedId} }"
        search=".onOpenObjectSearch" />
    <Tree
        id="workspaceTree"
        visible="{= ${ide>/session/type} !== 'diagnose' }"
        mode="SingleSelectMaster"
        busy="{ide>/filesBusy}"
        busyIndicatorDelay="0"
        noDataText="{i18n>noFiles}"
        ariaLabelledBy="workspaceTitle"
        selectionChange=".onFileSelect"
        items="{ path: 'ide>/files', parameters: { arrayNames: ['nodes'] } }">
        <CustomTreeItem type="{= ${ide>folder} ? 'Inactive' : 'Active' }">
            <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%" class="agentIdeTreeRow">
                <HBox alignItems="Center">
                    <core:Icon
                        src="{= ${ide>folder} ? 'sap-icon://folder-blank' : 'sap-icon://document-text' }"
                        decorative="true"
                        class="sapUiTinyMarginEnd" />
                    <Text text="{ide>text}" tooltip="{ide>path}" wrapping="false" />
                </HBox>
                <ObjectStatus
                    visible="{= !${ide>folder} }"
                    text="{ path: 'ide>state', formatter: '.formatter.stateText' }"
                    state="{ path: 'ide>state', formatter: '.formatter.stateBadge' }"
                    inverted="true"
                    class="sapUiTinyMarginBegin" />
            </HBox>
        </CustomTreeItem>
    </Tree>
</core:FragmentDefinition>
