<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:codeeditor="sap.ui.codeeditor">
    <OverflowToolbar id="editorToolbar">
        <Title id="editorTitle" text="{i18n>editorTitle}" level="H2" />
        <ToolbarSpacer />
        <MenuButton
            id="documentsButton"
            text="{i18n>documentsButton}"
            icon="sap-icon://document-text"
            type="Transparent"
            tooltip="{i18n>documentsTooltip}"
            enabled="{= ${ide>/docKinds}.length > 0 }">
            <menu>
                <Menu id="documentsMenu" itemSelected=".onDocumentMenuSelect" items="{ide>/docKinds}">
                    <MenuItem text="{ide>label}" />
                </Menu>
            </menu>
        </MenuButton>
    </OverflowToolbar>
    <core:InvisibleText id="versionLabelText" text="{i18n>versionLabel}" />

    <Text
        id="editorEmpty"
        text="{i18n>editorEmpty}"
        visible="{= ${ide>/tabs}.length === 0 }"
        class="sapUiSmallMargin" />

    <TabContainer
        id="editorTabs"
        visible="{= ${ide>/tabs}.length > 0 }"
        showAddNewButton="false"
        itemClose=".onEditorTabClose"
        itemSelect=".onEditorTabSelect"
        items="{ path: 'ide>/tabs', key: 'key' }"
        class="ideEditorTabs">
        <layoutData>
            <FlexItemData growFactor="1" baseSize="0" minHeight="0" />
        </layoutData>
        <items>
        <TabContainerItem key="{ide>key}" name="{ide>title}" additionalText="{ide>subtitle}">
            <content>
                <VBox class="ideEditorTab" width="100%" height="100%" busy="{ide>busy}" busyIndicatorDelay="0">
                    <!-- File tab -->
                    <OverflowToolbar visible="{= ${ide>kind} === 'file' }" style="Clear">
                        <SegmentedButton
                            selectedKey="{ide>mode}"
                            selectionChange=".onEditorModeChange"
                            ariaLabelledBy="editorTitle">
                            <layoutData>
                                <OverflowToolbarLayoutData priority="NeverOverflow" />
                            </layoutData>
                            <items>
                                <SegmentedButtonItem key="source" text="{i18n>modeSource}" />
                                <SegmentedButtonItem key="proposed" text="{i18n>modeProposed}" enabled="{ide>hasProposal}" />
                                <SegmentedButtonItem key="diff" text="{i18n>modeDiff}" enabled="{ide>hasProposal}" />
                            </items>
                        </SegmentedButton>
                        <ToolbarSpacer />
                        <ObjectStatus
                            text="{ path: 'ide>lintSummary' }"
                            visible="{= !!${ide>lintSummary} }"
                            state="{ide>lintState}" />
                        <Button
                            id="lintButton"
                            text="{i18n>lintButton}"
                            icon="sap-icon://quality-issue"
                            tooltip="{i18n>lintTooltip}"
                            enabled="{ide>isObject}"
                            press=".onLintFile">
                            <layoutData>
                                <OverflowToolbarLayoutData priority="High" />
                            </layoutData>
                        </Button>
                        <Button
                            id="refreshButton"
                            text="{i18n>refreshButton}"
                            icon="sap-icon://refresh"
                            tooltip="{i18n>refreshTooltip}"
                            enabled="{ide>isObject}"
                            press=".onRefreshFile">
                            <layoutData>
                                <OverflowToolbarLayoutData priority="High" />
                            </layoutData>
                        </Button>
                    </OverflowToolbar>
                    <codeeditor:CodeEditor
                        visible="{= ${ide>kind} === 'file' &amp;&amp; ${ide>mode} !== 'diff' }"
                        type="{ide>editorType}"
                        value="{ide>text}"
                        editable="false"
                        lineNumbers="true"
                        syntaxHints="false"
                        height="100%"
                        width="100%">
                        <codeeditor:layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minHeight="0" />
                        </codeeditor:layoutData>
                    </codeeditor:CodeEditor>
                    <core:HTML
                        visible="{= ${ide>kind} === 'file' &amp;&amp; ${ide>mode} === 'diff' }"
                        content="{ide>diffHtml}"
                        preferDOM="false">
                        <core:layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minHeight="0" />
                        </core:layoutData>
                    </core:HTML>

                    <!-- Document tab (design / plan / note / review artifact) -->
                    <OverflowToolbar visible="{= ${ide>kind} === 'doc' }" style="Clear">
                        <Label text="{i18n>versionLabel}" />
                        <Select
                            id="docVersionSelect"
                            ariaLabelledBy="versionLabelText"
                            selectedKey="{ide>artifactId}"
                            change=".onDocVersionChange"
                            items="{ path: 'ide>versions', templateShareable: false }">
                            <core:Item key="{ide>id}" text="{ide>label}" />
                        </Select>
                    </OverflowToolbar>
                    <core:HTML
                        visible="{= ${ide>kind} === 'doc' }"
                        content="{ide>html}"
                        preferDOM="false">
                        <core:layoutData>
                            <FlexItemData growFactor="1" baseSize="0" minHeight="0" />
                        </core:layoutData>
                    </core:HTML>
                </VBox>
            </content>
        </TabContainerItem>
        </items>
    </TabContainer>
</core:FragmentDefinition>
