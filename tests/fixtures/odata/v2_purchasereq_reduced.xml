          <End EntitySet="A_PurchaseRequisitionItem" Role="ToRole_assoc_Header_Item"/>
        </AssociationSet>
        <FunctionImport Name="ReleaseItem" ReturnType="PURCHASEREQ_SRV.A_PurchaseRequisitionItemType" EntitySet="A_PurchaseRequisitionItem" m:HttpMethod="POST" sap:action-for="PURCHASEREQ_SRV.A_PurchaseRequisitionItemType" sap:label="Release item">
