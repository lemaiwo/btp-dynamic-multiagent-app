.env
.env.bak*
# Google OAuth client secret JSON downloaded from Cloud Console
client_secret_*.json
.tokens.json
.tokens-*.json

# Client certificates and keys. An SAP Passport (.pfx) authenticates as a
# named S-user; committing one hands over that identity. These belong in a
# CF secure environment variable or a mounted volume, never the repo.
*.pfx
*.p12
*.pem
*.key
__pycache__/
*.pyc
.venv/
mta_archives/
*.mtar
dist/
node_modules/
agents_registry.db
tests/_*.db

ui5-admin/node_modules/
ui5-admin/dist/
resources/

# --- Landscape-specific, do not commit ---
# MTA extension descriptors pin one landscape's routes, AI Core resource
# group and PUBLIC_BASE_URL (e.g. <landscape>.mtaext). Every landscape needs
# its own; committing one invites deploying another landscape's values.
*.mtaext

# Documentation and exported agent/workflow bundles. Both name real
# landscapes -- CF orgs and spaces, approuter hosts, destination names, OAuth
# client ids and identity-provider tenant ids. This is a public repo, so they
# stay local; docs/ was purged from history for the same reason.
docs/

# Tests whose fixtures name a real landscape (destination URLs, ARC-1 hosts,
# AI Core resource groups). They still run locally -- they sit under tests/,
# so pytest finds them -- but they are not ours to publish.
tests/local/

# Fetched SAP note payloads and other scratch artifacts. Note content is
# SAP-licensed material and support-backbone output; it is not ours to commit.
tmp/
